# Segmented regression (inflexion point at Blow for low productivity scenario)
Blim_low #change point of Hockey stick for the low productivity 

pilsr2 <- FLSR(rec=pil@n[1,], ssb=ssb(pil))

model(pilsr2) <- segreg()

yrs.srlow <- 2006:2024
